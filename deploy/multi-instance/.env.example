# Copy to .env (ignored). Replace placeholders before running. Never commit real secrets.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_ONE_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARS
MONITORING_SECRET_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_MONITORING_TOKEN
LB_BIND_IP=127.0.0.1
LB_PORT=8088
POSTGRES_USER=diagram
POSTGRES_DB=diagram_multi
POSTGRES_MAX_CONNECTIONS=50
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=1
BACKEND_CPUS=1.0
BACKEND_MEMORY=1024m
JAVA_HEAP_MB=512
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1024m
NGINX_CPUS=0.25
NGINX_MEMORY=128m
SPRING_PROFILES_ACTIVE=default
CORS_ALLOWED_ORIGINS=http://localhost:3000
SAMPLE_ACCOUNT_ACTION=disable
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=2KB
SHARING_DEFAULT_LINK_TTL=7d
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
