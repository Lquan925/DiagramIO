# PostgreSQL / Docker Compose
POSTGRES_USER=root
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=diagram_app
POSTGRES_PORT=5432

# Cổng mở ra máy cho app khi chạy bằng docker compose
APP_PORT=8080

# Spring Boot datasource values when the application runs on the host
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diagram_app
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=secretpassword

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

SHARING_DEFAULT_LINK_TTL=7d

# local is safe only with one application instance and no external database writers
CACHE_MODE=disabled
CACHE_DIAGRAM_MAX_WEIGHT_BYTES=67108864
CACHE_DIAGRAM_TTL=60s
CACHE_SHARE_MAX_ENTRIES=10000
CACHE_SHARE_TTL=30s
